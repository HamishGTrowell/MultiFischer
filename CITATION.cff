cff-version: 1.2.0
message: "If you use MultiFischer in research, please cite this software and the original Fischer method."
title: "MultiFischer"
type: software
version: 1.0.0
date-released: 2026-08-13
authors:
  - family-names: "Trowell"
    given-names: "Hamish G"
    email: "hamish.trowell@gmail.com"
repository-code: "https://github.com/HamishGTrowell/MultiFischer"
url: "https://github.com/HamishGTrowell/MultiFischer"
license: MIT
abstract: >-
  MultiFischer is a command-line program for extended Fischer analysis of
  photoswitch photostationary-state compositions from UV-Vis spectra. It
  aggregates results from multiple irradiation-wavelength pairs and filters
  nonphysical and anomalous estimates.
references:
  - type: article
    authors:
      - family-names: "Fischer"
        given-names: "Ernst"
    title: "Calculation of photostationary states in systems A ⇄ B when only A is known"
    journal: "The Journal of Physical Chemistry"
    year: 1967
    volume: 71
    issue: 11
    start: 3704
    end: 3706
    doi: "10.1021/j100870a063"
